# Maintainer: Marc-Etienne Barrut <lekva+github@arzaroth.com>
#
# Builds remuda from the release's source tarball. The release workflow
# attaches a copy of this file with pkgver and sha256sums filled in; the copy
# in the repository keeps SKIP, since it lives inside the tarball it would
# have to checksum.

pkgname=remuda
pkgver=0.15.0
pkgrel=1
pkgdesc="Keep several Claude Code, Codex, Grok, Kimi and Cursor logins and switch the one each CLI uses"
arch=('x86_64' 'aarch64')
url="https://github.com/Arzaroth/remuda"
license=('MIT OR WTFPL')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
conflicts=('remuda-bin')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
  mkdir -p target/completions
  target/release/remuda completions bash >target/completions/remuda.bash
  target/release/remuda completions zsh >target/completions/_remuda
  target/release/remuda completions fish >target/completions/remuda.fish
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/remuda "$pkgdir/usr/bin/remuda"
  install -d "$pkgdir/usr/lib/systemd/user"
  for unit in systemd/*; do
    sed 's|^ExecStart=%h/\.local/bin/remuda |ExecStart=/usr/bin/remuda |' "$unit" \
      >"$pkgdir/usr/lib/systemd/user/${unit##*/}"
  done
  install -Dm644 target/completions/remuda.bash "$pkgdir/usr/share/bash-completion/completions/remuda"
  install -Dm644 target/completions/_remuda "$pkgdir/usr/share/zsh/site-functions/_remuda"
  install -Dm644 target/completions/remuda.fish "$pkgdir/usr/share/fish/vendor_completions.d/remuda.fish"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE LICENSE-MIT LICENSE-WTFPL
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
